# Plataxi Landing — environment contract
# Copy to `.env.local` for development: `cp .env.example .env.local`
#
# Identity, contact, social, product, and style values are constants
# compiled into the build (see src/lib/config.ts). They are NOT listed
# here — edit them directly in config.ts if they change.
#
# A PRODUCTION build (`next build`) will FAIL only if the 3 ⚠️ keys below
# are still unresolved (missing, empty, or matching the sentinel values).
# Set them to real deployment values before a production build.
#
# Do not commit real secrets; `.env.local` is gitignored.

# ──── Backend (⚠️ production-guarded — must be real) ────

# ⚠️ Public Core rates endpoint — read from the browser.
NEXT_PUBLIC_RATES_CONFIG_ENDPOINT=http://localhost:8000/api/v1/sessions/rates-config

# ⚠️ Server-only Core web-lead intake endpoint.
APPLICATION_ENDPOINT=http://localhost:8000/api/v1/intake/web-lead

# ⚠️ Server-only shared secret. Must match Core's LANDING_API_KEY.
# Never expose with NEXT_PUBLIC_.
LANDING_API_KEY=dev-landing-api-key-change-in-production

# ──── Analytics (optional) ────

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). If empty, no GTM script loads.
# NEXT_PUBLIC_GTM_ID=

# ──── Vercel deployment URLs ────
# Production:  https://plataxi-landing-git-main-kevin-vicents-projects.vercel.app
# Preview:     https://plataxi-landing-ayu4isfs8-kevin-vicents-projects.vercel.app
# Target:      https://plataxi.rubrica.dev (redirect destination)

# ──── CI / Preview ────

# Escape hatch: allow a production build with placeholders still set
# (for axe/Lighthouse against a non-live build). Never enable in real prod.
# NEXT_PUBLIC_PLATAXI_ALLOW_PLACEHOLDERS=false
